    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "gsap": "^3.15.0",
    "three": "^0.186.1"
